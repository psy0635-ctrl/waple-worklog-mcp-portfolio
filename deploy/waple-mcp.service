# Waple 업무일지 MCP 서버 - 사용자 systemd 서비스 유닛
#
# 설치 위치: ~/.config/systemd/user/waple-mcp.service
# 시스템 레벨(/etc/systemd/system)이 아닌 "사용자 레벨"을 사용한다.
# 배포 서버에서 sudo 권한이 nginx 관련 명령으로만 제한되어 있어
# 루트 권한 없이 서비스를 운영하기 위한 선택이다.

[Unit]
Description=Waple Worklog MCP Server (Streamable HTTP)

[Service]
Type=simple

# %h = 실행 사용자의 홈 디렉터리로 자동 치환된다.
WorkingDirectory=%h/waple-worklog-mcp

# systemd는 셸을 거치지 않으므로 'source .venv/bin/activate'가 동작하지 않는다.
# 가상환경의 python 실행 파일을 직접 지정해야 한다.
ExecStart=%h/waple-worklog-mcp/.venv/bin/python server.py --transport streamable-http --port 8010

# 프로세스가 비정상 종료되면 5초 후 자동으로 다시 기동한다.
Restart=always
RestartSec=5

# 기존 로그를 덮어쓰지 않고 이어서 기록한다.
StandardOutput=append:%h/mcp.log
StandardError=append:%h/mcp.log

[Install]
WantedBy=default.target
